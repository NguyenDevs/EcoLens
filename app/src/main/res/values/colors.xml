<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================ -->
    <!-- MODERN ECOLENS COLOR PALETTE (2024)         -->
    <!-- Based on Google Stitch HTML Design          -->
    <!-- ============================================ -->

    <!-- ==================== PRIMARY COLORS ==================== -->
    <!-- Main brand colors - Emerald green theme -->
    <color name="primary">#065F46</color>    <!-- Dark emerald - HTML primary -->
    <color name="primary_dark">#064E3B</color>    <!-- Darker emerald - emerald-900 -->
    <color name="primary_light">#10B981</color>    <!-- Bright emerald - accent -->
    <color name="accent">#10B981</color>    <!-- Accent color - emerald-500 -->
    <color name="on_primary">#FFFFFF</color>

    <!-- Primary variants for different opacity -->
    <color name="primary_10">#1A065F46</color>    <!-- 10% opacity -->
    <color name="primary_20">#33065F46</color>    <!-- 20% opacity -->
    <color name="primary_30">#4D065F46</color>    <!-- 30% opacity -->
    <color name="primary_40">#66065F46</color>    <!-- 40% opacity -->

    <!-- ==================== SURFACE COLORS ==================== -->
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F9FAFB</color>    <!-- HTML background-light -->
    <color name="surface_tint">#ECFDF5</color>    <!-- emerald-50 tint -->
    <color name="background">#F9FAFB</color>    <!-- Match HTML bg-background-light -->
    <color name="background_dark">#0F172A</color>    <!-- HTML bg-background-dark (slate-900) -->
    <color name="on_surface">#0F172A</color>    <!-- slate-900 -->

    <!-- Glass effect colors -->
    <color name="glass_light">#E6FFFFFF</color>        <!-- rgba(255,255,255,0.9) -->
    <color name="glass_dark">#E60F172A</color>         <!-- rgba(15,23,42,0.9) -->
    <color name="glass_nav">#E8FFFFFF</color>          <!-- For floating nav bar -->
    <!-- ==================== TEXT COLORS ==================== -->
    <!-- Slate color palette from Tailwind -->
    <color name="text_primary">#0F172A</color>    <!-- slate-900 -->
    <color name="text_secondary">#64748B</color>    <!-- slate-500 -->
    <color name="text_tertiary">#94A3B8</color>    <!-- slate-400 -->
    <color name="text_disabled">#CBD5E1</color>    <!-- slate-300 -->
    <color name="text_on_primary">#FFFFFF</color>

    <!-- ==================== BORDER COLORS ==================== -->
    <color name="border_light">#F1F5F9</color>    <!-- slate-100 -->
    <color name="border_normal">#E2E8F0</color>    <!-- slate-200 -->
    <color name="border_strong">#CBD5E1</color>    <!-- slate-300 -->

    <!-- ==================== SEMANTIC COLORS ==================== -->
    <!-- Success - Emerald -->
    <color name="success">#10B981</color>    <!-- emerald-500 -->
    <color name="success_bg">#ECFDF5</color>    <!-- emerald-50 -->
    <color name="success_text">#065F46</color>    <!-- emerald-800 -->

    <!-- Warning - Amber -->
    <color name="warning">#F59E0B</color>    <!-- amber-500 -->
    <color name="warning_bg">#FFFBEB</color>    <!-- amber-50 -->
    <color name="warning_text">#B45309</color>    <!-- amber-700 -->

    <!-- Error - Red -->
    <color name="error">#EF4444</color>    <!-- red-500 -->
    <color name="error_bg">#FEF2F2</color>    <!-- red-50 -->
    <color name="error_text">#B91C1C</color>    <!-- red-700 -->

    <!-- Info - Blue -->
    <color name="info">#3B82F6</color>    <!-- blue-500 -->
    <color name="info_bg">#EFF6FF</color>    <!-- blue-50 -->
    <color name="info_text">#1D4ED8</color>    <!-- blue-700 -->

    <!-- ==================== CONFIDENCE LEVELS ==================== -->
    <color name="confidence_high">#10B981</color>
    <color name="confidence_high_bg">#ECFDF5</color>
    <color name="confidence_high_text">#065F46</color>

    <color name="confidence_medium">#F59E0B</color>
    <color name="confidence_medium_bg">#FFFBEB</color>
    <color name="confidence_medium_text">#B45309</color>

    <color name="confidence_low">#EF4444</color>
    <color name="confidence_low_bg">#FEF2F2</color>
    <color name="confidence_low_text">#B91C1C</color>

    <!-- ==================== INTERACTIVE STATES ==================== -->
    <color name="state_hover">#F8FAFC</color>    <!-- slate-50 -->
    <color name="state_pressed">#F1F5F9</color>    <!-- slate-100 -->
    <color name="state_focus">#DBEAFE</color>    <!-- blue-100 -->
    <color name="state_disabled">#F1F5F9</color>    <!-- slate-100 -->

    <!-- ==================== OVERLAY COLORS ==================== -->
    <color name="overlay_dark">#80000000</color>    <!-- 50% black -->
    <color name="overlay_light">#80FFFFFF</color>    <!-- 50% white -->
    <color name="scrim">#99000000</color>    <!-- 60% black -->

    <!-- ==================== NAVIGATION ==================== -->
    <color name="nav_selected">#065F46</color>    <!-- primary dark emerald -->
    <color name="nav_unselected">#94A3B8</color>    <!-- slate-400 -->
    <color name="nav_background">#FFFFFF</color>

    <!-- ==================== UTILS ==================== -->
    <color name="transparent">#00FFFFFF</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- ==================== HERO CARD COLORS ==================== -->
    <color name="hero_bg">#065F46</color>    <!-- emerald-800 -->
    <color name="hero_bg_dark">#064E3B</color>    <!-- emerald-900 for dark mode -->
    <color name="hero_text">#FFFFFF</color>
    <color name="hero_text_secondary">#A7F3D0</color>    <!-- emerald-100 with 80% opacity -->
    <color name="hero_badge_bg">#33FFFFFF</color>    <!-- white 20% opacity -->

    <!-- ==================== GRADIENTS (for drawables) ==================== -->
    <color name="gradient_start">#065F46</color>
    <color name="gradient_end">#10B981</color>

    <!-- ==================== SHADOWS ==================== -->
    <color name="shadow_light">#14000000</color>    <!-- 8% opacity -->
    <color name="shadow_normal">#1F000000</color>    <!-- 12% opacity -->
    <color name="shadow_strong">#29000000</color>    <!-- 16% opacity -->
    <color name="shadow_primary">#33065F46</color>    <!-- primary 20% for hero shadow -->

    <!-- ==================== BACKWARD COMPATIBILITY ==================== -->
    <!-- Alias for old color names to prevent compile errors -->

    <!-- Old green colors -->
    <color name="green_primary">@color/primary</color>
    <color name="green_primary_2">@color/primary_dark</color>
    <color name="green_light">@color/primary_light</color>
    <color name="green_dark">@color/success_text</color>

    <!-- Old background colors -->
    <color name="background_light">@color/surface_variant</color>
    <color name="background_color">@color/background</color>
    <color name="background_soft">@color/background</color>

    <!-- Old surface / divider -->
    <color name="surface_white">@color/surface</color>
    <color name="divider_color">@color/border_normal</color>

    <!-- Old bottom navigation -->
    <color name="bottom_nav_selected">@color/nav_selected</color>
    <color name="bottom_nav_unselected">@color/nav_unselected</color>

    <!-- Old error colors -->
    <color name="error_red">@color/error</color>
    <color name="error_background">@color/error_bg</color>

    <!-- Old gray utilities -->
    <color name="gray">@color/text_secondary</color>
    <color name="gray_light">@color/state_disabled</color>
    <color name="gray_light_f8">@color/surface_variant</color>

