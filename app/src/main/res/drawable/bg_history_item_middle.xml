<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_normal"/>
        </shape>
    </item>
    <!-- Content (offset to show border on left/right only) -->
    <item
            android:left="1dp"
            android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
        </shape>
    </item>
</layer-list>