<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Glass effect - semi-transparent white -->
    <solid android:color="@color/glass_nav" />
    
    <!-- Fully rounded corners like floating island -->
    <corners android:radius="@dimen/radius_2xl" />
    
    <!-- Subtle border -->
    <stroke
        android:width="@dimen/border_thin"
        android:color="@color/border_light" />
    
</shape>
