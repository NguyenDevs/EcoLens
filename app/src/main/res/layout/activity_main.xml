<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".MainActivity">

    <FrameLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <include
                android:id="@+id/homeContainer"
                layout="@layout/screen_home"
                android:visibility="visible"/>

        <FrameLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

        <FrameLayout
                android:id="@+id/myGardenContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

        <include
                android:id="@+id/settingsContainer"
                layout="@layout/screen_settings"
                android:visibility="gone"/>
    </FrameLayout>

    <!-- SEARCH BAR -->
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchBarContainer"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_gravity="top|end"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="@dimen/border_thin"
            app:strokeColor="@color/border_normal">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <ImageView
                    android:id="@+id/btnSearchAction"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:padding="@dimen/spacing_sm"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary"
                    app:elevation="1dp"
                    app:pressedTranslationZ="@dimen/elevation_xl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSearch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="10dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@id/btnSearchAction"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="@dimen/text_body"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingEnd="42dp"
                        android:textColorHint="@color/text_tertiary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                    android:id="@+id/ivSearchClearMain"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_tertiary"
                    android:padding="10dp"
                    android:alpha="0.6"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- VOICE CONTROL BUTTONS -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeak"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:contentDescription="@string/speak"
            android:src="@drawable/ic_speak"
            app:tint="@color/white"
            app:fabSize="normal"
            app:maxImageSize="30dp"
            app:fabCustomSize="50dp"
            style="@style/Widget.App.FloatingActionButton"
            app:elevation="13dp"
            app:pressedTranslationZ="@dimen/elevation_xl"
            app:layout_anchorGravity="top|end"
            android:layout_gravity="top|end"
            android:visibility="gone"/>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardCornerRadius="@dimen/radius_3xl"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_nav"
            app:strokeWidth="@dimen/border_thin"
            app:strokeColor="@color/border_light">

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/bottomNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    style="@style/Widget.App.BottomNavigationView"
                    app:itemTextAppearanceActive="@style/BottomNavTextRegular"
                    app:itemTextAppearanceInactive="@style/BottomNavTextRegular"
                    app:menu="@menu/bottom_nav_menu"
                    app:itemRippleColor="@null"
                    android:paddingTop="@dimen/spacing_xxs"
                    android:paddingBottom="@dimen/spacing_xs"/>

            <!-- Camera FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabCamera"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="@string/camera"
                    android:scaleType="center"
                    app:fabCustomSize="56dp"
                    app:maxImageSize="34dp"
                    style="@style/Widget.App.FloatingActionButton"
                    app:elevation="10dp"
                    app:pressedTranslationZ="12dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.FullRoundedComponent"/>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- FULLSCREEN IMAGE VIEWER -->
    <FrameLayout
            android:id="@+id/fullScreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:elevation="100dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

        <ImageView
                android:id="@+id/fullScreenImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/fullscreen_image"/>

        <ImageView
                android:id="@+id/btnZoomOut"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/spacing_md"
                android:src="@drawable/ic_zoomout"
                android:background="@drawable/rounded_dark_bg"
                android:padding="@dimen/spacing_sm"
                app:tint="@color/white"
                android:contentDescription="@string/zoom_out"/>
    </FrameLayout>

    <!-- FRAGMENT CONTAINER FOR DETAIL SCREENS -->
    <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:translationZ="100dp"
            android:clickable="true"
            android:focusable="true"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>