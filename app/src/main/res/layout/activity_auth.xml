<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true"
            tools:context=".activities.AuthActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

        <!-- Logo và Animation Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/logoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_logo_description"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedCornerImageView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <!-- Optional: Thêm illustration/animation ở đây -->
            <ImageView
                    android:id="@+id/ivIllustration"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:contentDescription="@string/eco_illustration"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivLogo"
                    tools:src="@drawable/ic_eco_illustration" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/welcome_to_ecolens"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logoContainer" />

        <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_subtitle"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcome"
                app:layout_constraintWidth_max="280dp" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutAuth"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="20dp"
                        app:tabIndicatorColor="@color/primary"
                        app:tabIndicatorHeight="3dp"
                        app:tabIndicatorFullWidth="false"
                        app:tabSelectedTextColor="@color/primary"
                        app:tabTextColor="@color/text_secondary"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        android:background="@android:color/transparent">
                    <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login"/>
                    <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/register"/>
                </com.google.android.material.tabs.TabLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:startIconDrawable="@drawable/ic_username"
                        app:startIconTint="@color/text_secondary"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/error"
                        app:helperTextEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text_primary"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="emailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/password"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_key"
                        app:startIconTint="@color/text_secondary"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/error"
                        app:counterEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input (for Register) -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/confirm_password"
                        android:visibility="gone"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_check_circle"
                        app:startIconTint="@color/text_secondary"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/error"
                        tools:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot Password / Terms -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <CheckBox
                            android:id="@+id/cbRememberMe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remember_me"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:buttonTint="@color/primary"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                    <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                    <TextView
                            android:id="@+id/tvForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forgot_password"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <!-- Terms for Register -->
                <CheckBox
                        android:id="@+id/cbAgreeTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/agree_terms"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:buttonTint="@color/primary"
                        android:visibility="gone"
                        android:minHeight="48dp"
                        tools:visibility="visible" />

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAuthAction"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/primary"
                        android:text="@string/login"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:minHeight="56dp"
                        app:cornerRadius="28dp"
                        app:elevation="2dp" />

                <!-- Progress Indicator -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:indeterminate="true"
                        app:indicatorColor="@color/primary"
                        tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider -->
        <LinearLayout
                android:id="@+id/layoutOr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/cardForm"
                app:layout_constraintStart_toStartOf="@id/cardForm"
                app:layout_constraintTop_toBottomOf="@id/cardForm">

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border_normal" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/or_continue_with"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border_normal" />
        </LinearLayout>

        <!-- Social Login Buttons -->
        <LinearLayout
                android:id="@+id/layoutSocialButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/cardForm"
                app:layout_constraintStart_toStartOf="@id/cardForm"
                app:layout_constraintTop_toBottomOf="@id/layoutOr">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/sign_in_with_google"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:minHeight="56dp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/border_normal"
                    app:strokeWidth="1.5dp" />

            <!-- Biometric Login Button (hiển thị nếu device support) -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBiometric"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/sign_in_with_biometric"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:minHeight="56dp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_fingerprint"
                    app:iconTint="@color/primary"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/border_normal"
                    app:strokeWidth="1.5dp"
                    tools:visibility="visible" />
        </LinearLayout>

        <!-- Bottom spacing -->
        <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:layout_constraintTop_toBottomOf="@id/layoutSocialButtons" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>