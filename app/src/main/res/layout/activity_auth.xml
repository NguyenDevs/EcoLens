<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2F4F5"
            android:scrollbars="none"

            android:fillViewport="true"
            tools:context=".activities.AuthActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:clipToPadding="false"
            android:clipChildren="false">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/logoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                <VideoView
                        android:id="@+id/videoLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_logo_description"
                        android:visibility="invisible" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_logo_description"
                    android:scaleType="centerCrop"
                    android:visibility="invisible"
                    app:shapeAppearanceOverlay="@style/RoundedCornerImageView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/welcome_to_ecolens"
                android:textColor="#1A1C1E"
                android:textSize="24sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logoContainer" />

        <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_subtitle"
                android:textAlignment="center"
                android:textColor="#707070"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcome"
                app:layout_constraintWidth_max="280dp" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="24dp">

                <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutAuth"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="20dp"
                        app:tabIndicatorColor="#018367"
                        app:tabIndicatorHeight="3dp"
                        app:tabIndicatorFullWidth="false"
                        app:tabSelectedTextColor="#018367"
                        app:tabTextColor="#707070"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        android:background="@android:color/transparent"
                        app:tabRippleColor="@android:color/transparent">
                    <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login"/>
                    <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/register"/>
                </com.google.android.material.tabs.TabLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email"
                        app:boxStrokeColor="#018367"
                        app:hintTextColor="#018367"
                        app:startIconDrawable="@drawable/ic_username"
                        app:startIconTint="#707070"
                        app:errorEnabled="true"
                        app:errorTextColor="#D32F2F"
                        app:helperTextEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#1A1C1E"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="emailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/password"
                        app:boxStrokeColor="#018367"
                        app:hintTextColor="#018367"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_key"
                        app:startIconTint="#707070"
                        app:errorEnabled="true"
                        app:errorTextColor="#D32F2F"
                        app:counterEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#1A1C1E"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input (for Register) -->
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/confirm_password"
                        android:visibility="gone"
                        app:boxStrokeColor="#018367"
                        app:hintTextColor="#018367"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_key"
                        app:startIconTint="#707070"
                        app:errorEnabled="true"
                        app:errorTextColor="#D32F2F"
                        tools:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#1A1C1E"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:importantForAutofill="yes"
                            android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot Password / Terms -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbRememberMe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remember_me"
                            android:textColor="#707070"
                            android:textSize="13sp"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:buttonTint="@color/checkbox_tint" />

                    <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                    <TextView
                            android:id="@+id/tvForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forgot_password"
                            android:textColor="#018367"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <!-- Terms for Register -->

                <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbAgreeTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/agree_terms"
                        android:textColor="#707070"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:minHeight="48dp"
                        app:buttonTint="@color/checkbox_tint"
                        tools:visibility="gone" />

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAuthAction"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#018367"
                        android:text="@string/login"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:minHeight="56dp"
                        app:cornerRadius="28dp"
                        app:elevation="2dp" />

                <!-- Progress Indicator -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:indeterminate="true"
                        app:indicatorColor="#018367"
                        tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider -->
        <LinearLayout
                android:id="@+id/layoutOr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/cardForm"
                app:layout_constraintStart_toStartOf="@id/cardForm"
                app:layout_constraintTop_toBottomOf="@id/cardForm">

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/or_continue_with"
                    android:textColor="#707070"
                    android:textSize="13sp" />

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />
        </LinearLayout>

        <!-- Social Login Buttons -->
        <LinearLayout
                android:id="@+id/layoutSocialButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/cardForm"
                app:layout_constraintStart_toStartOf="@id/cardForm"
                app:layout_constraintTop_toBottomOf="@id/layoutOr">

            <!-- Biometric Login Button (hiển thị nếu device support) -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/sign_in_with_google"
                    android:textAllCaps="false"
                    android:textColor="#1A1C1E"
                    android:textSize="15sp"
                    android:minHeight="56dp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1.5dp"/>
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBiometric"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/sign_in_with_biometric"
                    android:textAllCaps="false"
                    android:textColor="#1A1C1E"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:minHeight="56dp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_fingerprint"
                    app:iconTint="#018367"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1.5dp"
                    tools:visibility="visible" />
        </LinearLayout>

        <!-- Bottom spacing -->
        <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:layout_constraintTop_toBottomOf="@id/layoutSocialButtons" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>