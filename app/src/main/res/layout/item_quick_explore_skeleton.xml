<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="@dimen/card_explore_width"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border_light">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="182dp"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

        <!-- Image Skeleton -->
        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgExplore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_explore_image_height"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
                android:background="@drawable/bg_skeleton_rounded"/>

        <!-- Name Skeleton -->
        <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_skeleton_rounded"/>

        <!-- Description Skeleton -->
        <View
                android:layout_width="100dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_skeleton_rounded"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
