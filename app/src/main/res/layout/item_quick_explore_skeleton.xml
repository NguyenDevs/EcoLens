<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/card_explore_width"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <!-- Image Skeleton -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_explore_image_height"
            android:background="@drawable/bg_skeleton_rounded" />

        <!-- Name Skeleton -->
        <View
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_skeleton_rounded" />

        <!-- Description Skeleton -->
        <View
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_skeleton_rounded" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
