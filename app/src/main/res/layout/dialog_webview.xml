<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <View
        android:id="@+id/handleBar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@color/border_light" />

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/handleBar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/gbif_map"
            style="@style/TextAppearance.App.Headline3"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btnGbifStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_toStartOf="@id/btnStyle"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_white_rounded"
            android:backgroundTint="@color/surface_tint"
            android:padding="8dp"
            android:src="@drawable/ic_gbif_style"
            app:tint="@color/text_primary"
            android:contentDescription="GBIF Map Style" />

        <ImageView
            android:id="@+id/btnStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_toStartOf="@id/btnClose"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_white_rounded"
            android:backgroundTint="@color/surface_tint"
            android:padding="8dp"
            android:src="@drawable/ic_style"
            app:tint="@color/text_primary"
            android:contentDescription="Map Style" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_white_rounded"
            android:backgroundTint="@color/surface_tint"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            android:contentDescription="@string/action_cancel" />
    </RelativeLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/webProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:indeterminate="false"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/surface_tint"
        app:trackThickness="3dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/webProgress">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="visible" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@array/gemini_colors"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />
    </FrameLayout>
</RelativeLayout>
