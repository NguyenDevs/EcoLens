<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_sm">

        <!-- Thumbnail Skeleton -->
        <View
            android:id="@+id/imgThumbnailSkeleton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_skeleton_rounded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Content Skeleton -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintStart_toEndOf="@id/imgThumbnailSkeleton"
            app:layout_constraintEnd_toStartOf="@id/timeContainerSkeleton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="120dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <View
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_rounded" />

        </LinearLayout>

        <!-- Time Container Skeleton -->
        <LinearLayout
            android:id="@+id/timeContainerSkeleton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <View
                android:layout_width="30dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_skeleton_rounded" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
