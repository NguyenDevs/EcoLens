<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
                name="item"
                type="com.nguyendevs.ecolens.models.history.HistoryEntry" />
    </data>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border_light">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_sm">

            <!-- Thumbnail Image + Shimmer -->
            <FrameLayout
                    android:id="@+id/frameThumbnail"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                <!-- Image thật -->
                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
                        tools:src="@drawable/home_tree"
                        android:visibility="visible" />

                <!-- Shimmer cho image -->
                <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmerThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:shimmer_auto_start="false"
                        app:shimmer_highlight_color="@color/background"
                        app:shimmer_duration="1500">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
                            android:src="@drawable/splash" />  <!-- hoặc @color/surface_variant + shape -->

                </com.facebook.shimmer.ShimmerFrameLayout>

            </FrameLayout>

            <!-- Content Container (name + scientific) -->
            <LinearLayout
                    android:id="@+id/contentContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_md"
                    app:layout_constraintStart_toEndOf="@id/frameThumbnail"
                    app:layout_constraintEnd_toStartOf="@id/timeContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                <!-- Common Name + Shimmer -->
                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <!-- Text thật -->
                    <TextView
                            android:id="@+id/tvCommonName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Kiến lửa đỏ"
                            android:visibility="visible" />

                    <!-- Shimmer cho common name -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmerCommonName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:shimmer_auto_start="false"
                            app:shimmer_highlight_color="@color/background"
                            app:shimmer_duration="1200">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                android:background="@mipmap/ic_launcher" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                </FrameLayout>

                <!-- Scientific Name + Shimmer -->
                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                    <!-- Text thật -->
                    <TextView
                            android:id="@+id/tvScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="italic"
                            android:fontFamily="serif"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Solenopsis invicta"
                            android:visibility="visible" />

                    <!-- Shimmer cho scientific name -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmerScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:shimmer_auto_start="false"
                            app:shimmer_highlight_color="@color/background"
                            app:shimmer_duration="1200">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:background="@mipmap/ic_launcher" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                </FrameLayout>

            </LinearLayout>


            <LinearLayout
                    android:id="@+id/timeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                        android:id="@+id/tvDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        tools:text="HÔM NAY" />

                <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="10:08" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>