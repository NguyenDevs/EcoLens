<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

    <!-- DATE HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dateHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            android:visibility="gone"
            tools:visibility="visible">

        <View
                android:id="@+id/dayDotWhite"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="@drawable/circle_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.428"/>

        <View
                android:id="@+id/dayDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_dot_filled"
                app:layout_constraintStart_toStartOf="@id/dayDotWhite"
                app:layout_constraintTop_toTopOf="@id/dayDotWhite"
                app:layout_constraintEnd_toEndOf="@id/dayDotWhite"
                app:layout_constraintBottom_toBottomOf="@id/dayDotWhite"/>

        <TextView
                android:id="@+id/tvDateHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                app:layout_constraintStart_toEndOf="@id/dayDotWhite"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="HÔM NAY"/>

        <View
                android:id="@+id/dayDivider"
                android:layout_width="0dp"
                android:layout_height="1.2dp"
                android:layout_marginStart="17dp"
                android:background="@color/primary_10"
                app:layout_constraintStart_toEndOf="@id/tvDateHeader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDateHeader"
                app:layout_constraintBottom_toBottomOf="@id/tvDateHeader"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CARD ITEM -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

        <androidx.cardview.widget.CardView
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                            <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivHistoryImage"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:scaleType="centerCrop"
                                    android:clickable="false"
                                    android:duplicateParentState="true"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.GridImageTop"
                                    app:strokeWidth="1.2dp"
                                    android:padding="1.2dp"
                                    app:strokeColor="@color/primary_10"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintDimensionRatio="W,1:1"
                                    tools:background="@color/emerald_100" />

                            <!-- Shimmer overlay for history grid image -->
                            <com.facebook.shimmer.ShimmerFrameLayout
                                    android:id="@+id/shimmer_history_image"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:shimmer_auto_start="false"
                                    app:shimmer_base_alpha="1.0"
                                    app:shimmer_duration="1500"
                                    app:layout_constraintStart_toStartOf="@id/ivHistoryImage"
                                    app:layout_constraintEnd_toEndOf="@id/ivHistoryImage"
                                    app:layout_constraintTop_toTopOf="@id/ivHistoryImage"
                                    app:layout_constraintBottom_toBottomOf="@id/ivHistoryImage">

                                <com.google.android.material.imageview.ShapeableImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.GridImageTop"
                                        android:src="@drawable/splash" />

                            </com.facebook.shimmer.ShimmerFrameLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <com.google.android.material.card.MaterialCardView
                                android:id="@+id/badgeSuccess"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                app:cardBackgroundColor="@color/primary"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="@dimen/radius_full">

                        <ImageView
                                android:id="@+id/ivBadgeIcon"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/white"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="10dp"
                        android:clickable="false"
                        android:duplicateParentState="true">

                    <TextView
                            android:id="@+id/tvHistoryCommonName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="Sóc đỏ"/>

                    <TextView
                            android:id="@+id/tvHistoryScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:textColor="@color/text_tertiary"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            tools:text="Sciurus vulgaris"/>

                    <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:clickable="false"
                            android:duplicateParentState="true">

                        <TextView
                                android:id="@+id/tvConfidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                tools:text="97%"/>

                        <TextView
                                android:id="@+id/tvHistoryTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"
                                tools:text="08:32"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>