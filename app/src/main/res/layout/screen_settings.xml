<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

    <!-- ==================== HEADER SECTION ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_screen_horizontal"
            android:paddingTop="@dimen/spacing_md"
            android:background="@color/background">

        <!-- Title -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/settings"
                android:textColor="@color/primary"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"/>
    </LinearLayout>
    <View
            android:layout_width="match_parent"
            android:background="@color/border_normal"
            android:layout_marginStart="@dimen/padding_screen_horizontal"
            android:layout_marginEnd="@dimen/padding_screen_horizontal"
            android:layout_height="1dp"/>

    <!-- ==================== SCROLL VIEW ==================== -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="52dp">

    <!-- ==================== PREFERENCES SECTION ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_md"
            android:paddingHorizontal="@dimen/padding_screen_horizontal">

        <!-- Section Header -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/preferences"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:textStyle="bold"/>

        <!-- Preferences Card -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light"
                app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Language Option -->
                <LinearLayout
                        android:id="@+id/languageOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_teal">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_language"
                                app:tint="@color/primary"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/language_label"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <TextView
                            android:id="@+id/tvCurrentLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_vietnamese"
                            android:textSize="@dimen/text_body_large"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:textColor="@color/text_tertiary"/>

                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/border_strong"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <!-- Dark Mode Option -->
                <LinearLayout
                        android:id="@+id/darkModeOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_indigo">
                        <ImageView
                                android:id="@+id/ivDarkModeIcon"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_moon"
                                app:tint="@color/indigo_600"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/dark_mode"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDarkMode"
                            android:layout_width="44dp"
                            android:layout_height="24dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/switch_track_selector"
                            app:useMaterialThemeColors="false"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ==================== CONFIG SECTION ==================== -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/padding_screen_horizontal">

            <!-- Section Header -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/config"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true"
                    android:textStyle="bold"/>

            <!-- Support Card -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    app:cardBackgroundColor="@color/surface"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_light"
                    app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <LinearLayout
                        android:id="@+id/btnTaxonomyLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_purple">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_taxonomy"
                                app:tint="@color/purple_600"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/taxonomy_language"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTaxoMode"
                            android:layout_width="44dp"
                            android:layout_height="24dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/switch_track_selector"
                            app:useMaterialThemeColors="false"/>
                </LinearLayout>

                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <LinearLayout
                        android:id="@+id/btnIUCN"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_pink">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_iucn"
                                app:tint="@color/instagram_pink"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/iucn_searching"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchIUCNMode"
                            android:layout_width="44dp"
                            android:layout_height="24dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/switch_track_selector"
                            app:useMaterialThemeColors="false"/>
                </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    <!-- ==================== SUPPORT SECTION ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_screen_horizontal">

        <!-- Section Header -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/support"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:textStyle="bold"/>

        <!-- Support Card -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light"
                app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                    android:id="@+id/btnFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_orange">
                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mail_new"
                            app:tint="@color/orange_600"/>
                </FrameLayout>

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/email_support"
                        android:textSize="@dimen/text_body_large"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"/>

                <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/border_strong"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ==================== ABOUT SECTION ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_screen_horizontal">

        <!-- Section Header -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/about_label"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:textStyle="bold"/>

        <!-- About Card -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light"
                app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Facebook -->
                <LinearLayout
                        android:id="@+id/btnFacebook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_blue">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_facebook_new"
                                app:tint="@color/facebook_blue"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/follow_on_facebook"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_open_new"
                            app:tint="@color/border_strong"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <!-- Instagram -->
                <LinearLayout
                        android:id="@+id/btnInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_pink">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_instagram_new"
                                app:tint="@color/instagram_pink"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/follow_on_instagram"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_open_new"
                            app:tint="@color/border_strong"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <!-- TikTok -->
                <LinearLayout
                        android:id="@+id/btnTiktok"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_slate">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_tiktok_new"
                                app:tint="@color/tiktok_black"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/follow_on_tiktok"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_open_new"
                            app:tint="@color/border_strong"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <!-- About -->
                <LinearLayout
                        android:id="@+id/aboutOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_slate">
                        <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_info"
                                app:tint="@color/text_secondary"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/about_app_title"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/border_strong"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ==================== ACCOUNT SECTION ==================== -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_screen_horizontal">

        <!-- Section Header -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/account"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:textStyle="bold"/>

        <!-- Account Card -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light"
                app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                <!-- Account Details Option -->
                <LinearLayout
                        android:id="@+id/accountDetailsOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_blue">
                        <ImageView
                                android:id="@+id/ivAccountPicture"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user"
                                app:tint="@color/user_blue"/>
                    </FrameLayout>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/account_details"
                            android:textSize="@dimen/text_body_large"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <ImageView
                            android:id="@+id/ivExpandIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_primary"/>
                </LinearLayout>

                <!-- Expandable Account Details Container -->
                <LinearLayout
                        android:id="@+id/accountDetailsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingStart="64dp"
                        android:paddingEnd="@dimen/spacing_md">

                    <View
                            android:id="@+id/dividerUsername"
                            android:layout_width="match_parent"
                            android:background="@color/border_light"
                            android:layout_height="1dp"/>

                    <!-- Change Username -->
                    <LinearLayout
                            android:id="@+id/changeUsernameOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/change_username"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <View
                            android:id="@+id/dividerChangepassword"
                            android:layout_width="match_parent"
                            android:background="@color/border_light"
                            android:layout_height="1dp"/>

                    <!-- Change Password -->
                    <LinearLayout
                            android:id="@+id/changePasswordOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/change_password"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <View
                            android:id="@+id/dividerLinkgoogle"
                            android:layout_width="match_parent"
                            android:background="@color/border_light"
                            android:layout_height="1dp"/>

                    <!-- Link Google Account -->
                    <LinearLayout
                            android:id="@+id/linkGoogleOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/link_google_account"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <View
                            android:id="@+id/dividerDeleteaccount"
                            android:layout_width="match_parent"
                            android:background="@color/border_light"
                            android:layout_height="1dp"/>

                    <!-- Delete Account -->
                    <LinearLayout
                            android:id="@+id/deleteAccountOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/delete_account"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/error"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                        android:layout_width="match_parent"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@color/border_light"
                        android:layout_height="1dp"/>

                <!-- Logout Option -->
                <LinearLayout
                        android:id="@+id/logoutOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                    <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_pink">
                        <ImageView
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/logout"/>
                    </FrameLayout>

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:layout_weight="1"
                                android:text="@string/logout"
                                style="@style/TextAppearance.App.Body1"
                                android:textColor="@color/primary_dark"
                                android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
