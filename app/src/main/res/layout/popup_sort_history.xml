<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sort_dropdown"
    android:elevation="12dp"
    android:paddingVertical="6dp">

    <!-- Newest First -->
    <LinearLayout
        android:id="@+id/sortRowNewest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/iconNewest"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radio_unchecked"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/labelNewest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sort_newest_first"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Oldest First -->
    <LinearLayout
        android:id="@+id/sortRowOldest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/iconOldest"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radio_unchecked"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/labelOldest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sort_oldest_first"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Alphabetical -->
    <LinearLayout
        android:id="@+id/sortRowAlpha"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/iconAlpha"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radio_unchecked"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/labelAlpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sort_az"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Confidence High -->
    <LinearLayout
        android:id="@+id/sortRowConfidence"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/iconConfidence"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radio_unchecked"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/labelConfidence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sort_confidence"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Favorite -->
    <LinearLayout
        android:id="@+id/sortRowFavorite"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/iconFavorite"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radio_unchecked"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/labelFavorite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sort_favorite"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

</LinearLayout>
