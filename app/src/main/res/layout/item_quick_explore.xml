<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/card_explore_width"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="@dimen/border_thin"
    app:strokeColor="@color/border_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <!-- Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgExplore"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_explore_image_height"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
            tools:src="@drawable/home_tree" />

        <!-- Name -->
        <TextView
            android:id="@+id/tvExploreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Sen đá" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvExploreDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Thực vật mọng nước" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
