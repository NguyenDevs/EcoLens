<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="@dimen/card_explore_width"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border_light">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

        <!-- Image section (giữ nguyên như bạn đã có) -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_explore_image_height">

            <!-- Ảnh thật -->
            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgExplore"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
                    android:visibility="visible"
                    tools:src="@drawable/succulent" />

            <!-- Shimmer overlay cho image -->
            <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="false"
                    app:shimmer_duration="1500">

                <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent"
                        android:background="@mipmap/ic_launcher" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- Name section với shimmer -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

            <!-- Text thật (Name) -->
            <TextView
                    android:id="@+id/tvExploreName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="visible"
                    tools:text="Sen đá" />

            <!-- Shimmer cho Name -->
            <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:shimmer_auto_start="false"
                    app:shimmer_duration="1500">

                <View
                        android:layout_width="80dp"
                        android:layout_height="20dp"
                android:background="@drawable/bg_skeleton_rounded" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- Description section với shimmer -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

            <!-- Text thật (Description) -->
            <TextView
                    android:id="@+id/tvExploreDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="visible"
                    tools:text="Thực vật mọng nước" />

            <!-- Shimmer cho Description -->
            <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:shimmer_auto_start="false"
                    app:shimmer_duration="1500">

                <View
                        android:layout_width="120dp"
                        android:layout_height="16dp"
                android:background="@drawable/bg_skeleton_rounded" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>