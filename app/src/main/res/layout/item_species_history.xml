<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <View
                android:id="@+id/timelineLine"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@color/primary_10"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dateHeaderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                <!-- Dot trắng lớn hơn - làm nền -->
                <View
                        android:id="@+id/dayDotWhite"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:background="@drawable/circle_white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintVertical_bias="0.428" />

                <!-- Dot xanh nhỏ hơn -->
                <View
                        android:id="@+id/dayDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ic_dot_filled"
                        app:layout_constraintStart_toStartOf="@id/dayDotWhite"
                        app:layout_constraintTop_toTopOf="@id/dayDotWhite"
                        app:layout_constraintEnd_toEndOf="@id/dayDotWhite"
                        app:layout_constraintBottom_toBottomOf="@id/dayDotWhite" />

                <TextView
                        android:id="@+id/tvDateHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.06"
                        app:layout_constraintStart_toEndOf="@id/dayDotWhite"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="HÔM NAY" />

                <View
                        android:id="@+id/dayDivider"
                        android:layout_width="0dp"
                        android:layout_height="1.2dp"
                        android:layout_marginStart="17dp"
                        android:background="@color/primary_10"
                        app:layout_constraintStart_toEndOf="@id/tvDateHeader"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvDateHeader"
                        app:layout_constraintBottom_toBottomOf="@id/tvDateHeader" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/itemContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivHistoryImage"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:scaleType="centerCrop"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                        app:strokeWidth="1.5dp"
                        android:padding="1.5dp"
                        app:strokeColor="@color/primary_10"
                        android:src="@mipmap/ic_launcher"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                        android:id="@+id/infoContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        app:layout_constraintStart_toEndOf="@id/ivHistoryImage"
                        app:layout_constraintEnd_toStartOf="@id/tvHistoryTime"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                            android:id="@+id/tvHistoryCommonName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="Sóc đỏ" />

                    <TextView
                            android:id="@+id/tvHistoryScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:textColor="@color/text_tertiary"
                            android:fontFamily="serif"
                            android:textStyle="italic"
                            tools:text="Sciurus vulgaris" />

                    <!-- Phần badge + confidence được đặt trong ConstraintLayout ngang -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp">

                        <TextView
                                android:id="@+id/tvCategoryBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_animal"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                tools:text="Động vật" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <TextView
                        android:id="@+id/tvHistoryTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="08:32" />

                <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgeSuccess"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="2dp"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        app:cardBackgroundColor="@color/primary"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/radius_full"
                        app:layout_constraintStart_toStartOf="@id/ivHistoryImage"
                        app:layout_constraintBottom_toBottomOf="@id/ivHistoryImage"
                        app:layout_constraintEnd_toEndOf="@id/ivHistoryImage"
                        app:layout_constraintHorizontal_bias="1.0">

                    <ImageView
                            android:id="@+id/ivBadgeIcon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/white" />

                </com.google.android.material.card.MaterialCardView>
                <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        tools:text="97%"
                        app:layout_constraintTop_toBottomOf="@+id/tvHistoryTime"
                        app:layout_constraintStart_toEndOf="@+id/infoContainer" android:layout_marginTop="30dp"
                />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </FrameLayout>

    <View
            android:id="@+id/itemDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:background="@color/border_light"/>

</LinearLayout>