<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

    <!-- DATE HEADER -->
    <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_xxs"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Hôm nay, 22/01/2026"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:visibility="gone"
            tools:visibility="visible"/>

    <!-- DIVIDER -->
    <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/spacing_xxs"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:background="@color/border_light"
            android:visibility="gone"/>

    <!-- ITEM CARD -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp">

        <!-- Avatar with Badge -->
        <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <!-- IMAGE -->
            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivHistoryImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/primary_20"
                    android:src="@mipmap/ic_launcher"/>

            <!-- Success Badge -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgeSuccess"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardBackgroundColor="@color/primary"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/radius_full">

                <ImageView
                        android:id="@+id/ivBadgeIcon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/white"/>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- INFO SECTION -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvHistoryTime"
                app:layout_constraintStart_toEndOf="@+id/avatarContainer"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:id="@+id/tvHistoryCommonName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_common_name"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

            <TextView
                    android:id="@+id/tvHistoryScientificName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_scientific_name"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="serif"
                    android:textStyle="italic"/>
        </LinearLayout>

        <!-- Time -->
        <TextView
                android:id="@+id/tvHistoryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:09"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>